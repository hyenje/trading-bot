# Binance credentials
BINANCE_API_KEY=YOUR_API_KEY_HERE
BINANCE_API_SECRET=YOUR_API_SECRET_HERE
BINANCE_FUTURES_API_KEY=YOUR_FUTURES_API_KEY_HERE
BINANCE_FUTURES_API_SECRET=YOUR_FUTURES_API_SECRET_HERE

# Safety defaults
USE_TESTNET=true
DRY_RUN=true
ALLOW_LIVE_TRADING=false

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5001
DASHBOARD_DEBUG=false

# Spot bot defaults
TRADING_SYMBOLS=BTC/USDT,ETH/USDT
TRADING_TIMEFRAME=1h
TRADING_ORDER_AMOUNT=100
TRADING_MAX_POSITIONS=5
TRADING_CHECK_INTERVAL=60

# BTC long/short futures testnet
ENABLE_LONG_SHORT_EXECUTION=false
LONG_SHORT_TIMEFRAME=10m
LONG_SHORT_ORDER_USDT=60
LONG_SHORT_LEVERAGE=1
LONG_SHORT_POLL_INTERVAL=600
LONG_SHORT_RISK_POLL_INTERVAL=180
BTC_LS_REGIME_TIMEFRAME=4h
BTC_LS_REQUIRE_REGIME_ALIGNMENT=true
BTC_LS_REVERSE_ONLY_WHEN_PROFITABLE=true
BTC_LS_MIN_REVERSE_NET_PNL_USDT=0.0
BTC_LS_FEE_RATE=0.001
LONG_SHORT_MAX_SIGNAL_AGE_MINUTES=30
LONG_SHORT_ENABLE_SIGNAL_CATCHUP=false
LONG_SHORT_STOP_LOSS_PCT=2.0
LONG_SHORT_TAKE_PROFIT_PCT=4.0
LONG_SHORT_MAX_HOLD_BARS=0
LONG_SHORT_BREAK_EVEN_AFTER_PCT=0.0
LONG_SHORT_MAX_DAILY_LOSS_PCT=3.0
LONG_SHORT_MAX_DAILY_LOSS_USDT=50
LONG_SHORT_MAX_DAILY_TRADES=10
LONG_SHORT_MAX_CONSECUTIVE_LOSSES=3
LONG_SHORT_COOLDOWN_AFTER_LOSSES_MINUTES=60

# Backtest
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_COMMISSION_RATE=0.001
BACKTEST_SLIPPAGE_RATE=0.0

# Telegram notifications
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
